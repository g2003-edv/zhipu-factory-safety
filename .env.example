# 复制为 .env 后填写；.env 已被 .gitignore 排除，不会进入版本库。

# 必填：智谱开放平台 API Key（https://open.bigmodel.cn/）
ZHIPU_API_KEY=your_zhipu_api_key_here

# 云端复核模型，默认 glm-4v-plus
GLM_MODEL=glm-4v-plus

# 摄像头源，逗号分隔按顺序尝试：0 表示本机摄像头，也可填 http://IP:8080/video
CAMERA_SOURCES=0

# 同一摄像头两次云端复核的最小间隔（秒），用于抑制告警风暴
ALERT_COOLDOWN=60

# YOLO 权重（首次运行自动下载）与行人检测置信度阈值
YOLO_WEIGHTS=yolov8n.pt
YOLO_CONF=0.35

# 云端连续失败多少次后熔断为仅本地告警
GLM_MAX_FAILURES=3
# 单次云端请求超时（秒）
GLM_TIMEOUT=30

# 输出位置
SCREENSHOT_DIR=alert_screenshot
LOG_CSV=告警日志.csv

# 是否显示预览窗口（无图形环境请设为 0）
ENABLE_PREVIEW=1
